# Export this in the API process. Same value as apps/web PDF_FILL_SECRET.
# Production (PDF_SERVICE_ENV=production) rejects fill when this is unset.
# Local development accepts the built-in dev-only-fill-secret instead.
PDF_FILL_SECRET=replace-with-a-long-random-string
# Comma-separated browser origins. "*" is dropped. Unset means http://localhost:3000.
ALLOWED_ORIGINS=http://localhost:3000
# FORMS_DIR=
PDF_SERVICE_ENV=development
# Per caller, from the X-Fill-Caller header the web server sends with the secret.
# Client X-Forwarded-For is not a rate-limit key.
PDF_RATE_LIMIT=60
PDF_MAX_BODY_BYTES=1000000
