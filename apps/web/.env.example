# Copy to apps/web/.env.local. Do not commit real keys.
# Clerk Dashboard → API keys. Convex URL comes from `npx convex dev`.

NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/sections
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/sections

# Server-only. Must match PDF_FILL_SECRET on the API process.
PDF_FILL_SECRET=replace-with-a-long-random-string

# Optional override for where this server calls the PDF API.
# API_URL=http://localhost:8000

# Set on the Convex deployment, not in this file:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-instance.clerk.accounts.dev
#   npx convex env set SENSITIVE_ID_KEY "$(openssl rand -base64 32)"
#   npx convex env set SENSITIVE_ID_KEY_VERSION 1
#   npx convex env set PDF_FILL_SECRET <same value as this file>
# MFA is enabled in the Clerk dashboard. No key is required here.
# Set Clerk session lifetime to 7 days or less, and require email verification.
