# Copy the web block to apps/web/.env.local. Do not commit real keys.
# The API process needs the same PDF_FILL_SECRET. See README "Accounts".

# --- apps/web (Next.js). Also listed in apps/web/.env.example ---
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/sections
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/sections

# Server-only. The Next.js fill route sends this to the PDF service.
# Do not prefix it with NEXT_PUBLIC_.
# Local dev uses dev-only-fill-secret when this is unset.
# Production (NODE_ENV=production, and PDF_SERVICE_ENV=production on the API)
# rejects fills until this is set to the same value on both processes.
PDF_FILL_SECRET=replace-with-a-long-random-string

# Optional. Where the Next.js server reaches the PDF API.
# API_URL=http://localhost:8000

# --- Convex dashboard (deployment env, not Next.js) ---
# Clerk Dashboard → Integrations → Convex → Frontend API URL, no trailing slash.
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-instance.clerk.accounts.dev
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
# 32 random bytes, base64. Generate with: openssl rand -base64 32
#   npx convex env set SENSITIVE_ID_KEY <value>
#   npx convex env set SENSITIVE_ID_KEY_VERSION 1
#   npx convex env set PDF_FILL_SECRET <same value as the API>
# SENSITIVE_ID_KEY=
# SENSITIVE_ID_KEY_VERSION=1

# --- apps/api ---
# PDF_FILL_SECRET=replace-with-a-long-random-string
# PDF_ALLOWED_ORIGINS=http://localhost:3000
# PDF_SERVICE_ENV=development
# PDF_RATE_LIMIT=60
# Rate limit key is X-Fill-Caller (Clerk user id or "demo"), not X-Forwarded-For.
# PDF_MAX_BODY_BYTES=1000000

# Clerk webhook signing secret (Svix). Dashboard → Webhooks → endpoint /api/webhooks/clerk.
# CLERK_WEBHOOK_SECRET=whsec_replace_me
# Convex deploy key, used only by that webhook to call the internal purge.
# CONVEX_DEPLOY_KEY=

# MFA is turned on in the Clerk dashboard (User & authentication → Multi-factor).
# No extra env var.
